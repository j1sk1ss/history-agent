ConfigurationScreen, ModelEditor, CapabilityEditor {
    background: #101010;
    color: #dddddd;
    align: center middle;
}
.settings-dialog {
    width: 84;
    max-width: 100%;
    height: 100%;
    max-height: 76;
    padding: 1 2;
}
.settings-body {
    height: 1fr;
    min-height: 1;
    padding-right: 1;
}
#settings-title, .dialog-title {
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}
.settings-dialog .muted {
    color: #888888;
    height: auto;
    margin-bottom: 1;
}
.settings-group {
    height: auto;
    border: round #333333;
    padding: 1 2;
    margin-bottom: 1;
}
.settings-group .section-title {
    height: auto;
    text-style: bold;
    margin-bottom: 1;
}
.settings-field { height: auto; margin-bottom: 1; }
.settings-field Label { height: auto; margin: 0; padding: 0; }
.settings-dialog Input, .settings-dialog Select {
    width: 100%;
    min-width: 0;
    margin: 0;
}
.settings-dialog Input { background: #191919; border: tall #333333; }
.settings-dialog Input:focus { border: tall #777777; }
.settings-dialog Input.-valid { border: tall #333333; }
.settings-dialog Input > .input--placeholder { color: #dddddd 40%; }
.settings-dialog Checkbox {
    width: 100%;
    height: auto;
    text-wrap: wrap;
    background: transparent;
    border: none;
    padding: 0;
    margin-bottom: 1;
}
.settings-dialog Collapsible {
    height: auto;
    background: transparent;
    border: round #333333;
    padding: 0 1;
    margin-bottom: 1;
}
.settings-dialog Collapsible > Contents { padding: 1; }
.settings-row { height: 3; margin-bottom: 1; }
.model-buttons { height: 3; grid-size: 3; grid-gutter: 1; }
.model-buttons Button { width: 1fr; min-width: 0; margin: 0; }
#connection-status { margin: 0; }
#connection-status Static { width: 1fr; height: 3; content-align: left middle; }
#check-connections { width: 9; min-width: 9; margin: 0; }
#system-one-status { height: auto; }
#model-connection-error, #settings-error, #model-editor-error, #policy-error {
    color: #e79797;
    height: auto;
}
.settings-actions { height: 3; margin-top: 1; }
.settings-actions Button { width: 1fr; min-width: 8; margin-right: 1; }
.settings-actions Button:last-child { margin-right: 0; }
.settings-dialog TextArea { height: 9; }
