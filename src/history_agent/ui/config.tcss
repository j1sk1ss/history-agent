ConfigurationScreen {
    background: #101010;
    color: #dddddd;
    align: center middle;
}
ConfigurationScreen #settings {
    width: 76;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    padding: 1 3;
}
ConfigurationScreen #settings-title {
    text-style: bold;
    margin-bottom: 1;
}
ConfigurationScreen .muted { color: #888888; height: auto; }
ConfigurationScreen #connection-status { height: 3; }
ConfigurationScreen #connection-status Static { width: 1fr; padding-top: 1; }
ConfigurationScreen #check-connections { width: 9; min-width: 9; }
ConfigurationScreen #model-connection-error {
    color: #e79797;
    height: auto;
}
ConfigurationScreen Label { margin-top: 1; }
ConfigurationScreen Input, ConfigurationScreen Select { margin: 0; }
ConfigurationScreen Input { background: #191919; border: tall #333333; }
ConfigurationScreen Input:focus { border: tall #777777; }
ConfigurationScreen Input.-valid { border: tall #333333; }
ConfigurationScreen Input > .input--placeholder { color: #dddddd 40%; }
ConfigurationScreen Collapsible {
    background: transparent;
    border: none;
    padding: 0;
    margin-top: 1;
}
ConfigurationScreen Checkbox { background: transparent; border: none; }
ConfigurationScreen #settings-error { color: #e79797; height: auto; }
ConfigurationScreen #settings-actions {
    dock: bottom;
    height: auto;
    margin-top: 1;
    background: #101010;
}
ConfigurationScreen Button { margin-right: 1; }
