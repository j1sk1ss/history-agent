Screen {
    background: #0e0e0e;
    color: #dddddd;
}
#topbar {
    height: 1;
    padding: 0 2;
    color: #888888;
}
#body { height: 1fr; align-horizontal: center; }
#welcome { display: none; width: 88; max-width: 100%; height: auto; padding: 0 3 1 3; }
#home-title { height: auto; margin-bottom: 1; color: #eeeeee; }
#home-subtitle { color: #888888; }
#body.home { align-vertical: middle; }
#body.home #welcome { display: block; }
#body.home #timeline { display: none; }
#unfinished-jobs {
    display: none;
    width: 88;
    max-width: 100%;
    height: auto;
    padding: 0 3;
    margin-bottom: 1;
}
#body.home.has-jobs #unfinished-jobs { display: block; }
#body.has-jobs #welcome { padding-bottom: 0; }
#body.has-jobs #home-subtitle { display: none; }
#jobs-title { height: 1; color: #aaaaaa; }
#jobs-list { height: auto; max-height: 6; }
.compact-jobs #jobs-list { max-height: 3; }
.job-row { height: 3; }
.job-description { width: 1fr; height: 2; color: #aaaaaa; }
.resume-job, .delete-job {
    min-width: 12;
    height: 3;
    margin-left: 1;
    border: tall #444444;
    background: #191919;
    color: #f56bb7;
}
.resume-job:hover, .resume-job:focus { border: tall #f56bb7; }
.delete-job { min-width: 9; color: #999999; }
.delete-job:hover, .delete-job:focus { border: tall #c77c7c; color: #e79797; }
#jobs-error { display: none; height: auto; max-height: 2; color: #e79797; }
#compose-area { height: auto; width: 100%; padding: 0 2; }
#body.home #compose-area { max-width: 88; }
#home-menu { display: none; height: auto; margin: 1 0 0 0; }
#body.home #home-menu { display: block; }
#home-menu Button {
    height: 1;
    border: none;
    background: transparent;
    color: #999999;
    min-width: 0;
    margin-right: 3;
    padding: 0 1;
}
#home-menu Button:hover, #home-menu Button:focus { color: #eeeeee; background: #242424; }
#input-hint { height: auto; color: #666666; padding: 0 1; margin-bottom: 1; }
#timeline {
    height: 1fr;
    padding: 0 2;
}
.card {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    background: transparent;
}
.card-title {
    height: auto;
    text-style: bold;
    color: #ededed;
    margin-bottom: 0;
}
.preview {
    height: auto;
    color: #b0b0b0;
}
.full-text {
    height: auto;
}
.reasoning {
    color: #888888;
}
.user {
    background: #191919;
    border-left: solid #cccccc;
}
.error {
    border-left: solid #b27b7b;
}
.tool {
    color: #999999;
}
Collapsible {
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}
Collapsible > Contents {
    padding: 0 0 0 1;
}
#metrics {
    height: auto;
    padding: 0 2;
    color: #888888;
}
#choices {
    height: auto;
    max-height: 3;
    padding: 0 1;
}
#composer {
    margin: 0;
    border: tall #333333;
    background: #191919;
}
#composer:focus {
    border: tall #777777;
}
#composer > .input--placeholder { color: #dddddd 40%; }
