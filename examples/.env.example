# Copy to .env, replace the placeholders, then load it in each shell:
# set -a
# . ./.env
# set +a
# The history agent does not automatically load .env files.

# Proxy only: LiteLLM provider/model IDs for chat models with tool calling.
# For example, anthropic/claude-sonnet-4-5 or gemini/gemini-2.5-pro.
# Replace both model IDs with models available to your provider accounts.
LITELLM_REVIEW_MODEL=provider/reviewer-model-with-tools
LITELLM_FAST_MODEL=provider/fast-model-with-tools

# Proxy only: keys for the upstream providers selected above.
LITELLM_REVIEW_API_KEY=replace-with-upstream-reviewer-key
LITELLM_FAST_API_KEY=replace-with-upstream-fast-model-key

# Proxy only: choose a long random key beginning with sk-.
LITELLM_MASTER_KEY=sk-replace-with-a-long-random-proxy-key

# In the agent settings, paste the proxy's client key into API key.
# The database-free local example accepts the master key set above.
# For an existing proxy, use the issued inference key.

# Optional history service authentication, independent of LiteLLM.
# HISTORY_USER=replace-with-history-user
# HISTORY_PASSWORD=replace-with-history-password
# Or set HISTORY_SESSION instead of username/password.
